/* 配色
 *
 * 全部装饰、分层与文字走同一条灰阶，语义色只有四个。
 * 正文不使用语义色：强调由字重承担。
 * 设计说明见 docs/chat-screen-design.md。
 *
 *   #000000  屏幕底
 *   #0A0A0A  栏底（状态栏、侧栏、输入区块、弹窗里的输入框）
 *   #1A1A1A  分层底（用户消息、选中项、普通提示、弹窗本体）
 *   #2A2A2A  装饰线（未聚焦的指示线、启动界面聚焦时的抬亮）
 *   #333333  分隔线（侧栏左边界、弹窗里的框线）
 *   #4A4A4A  四级文字（快捷键提示、侧栏开关、弹窗里的元信息）
 *   #5A5A5A  三级文字（状态栏、模式提示、历史提示、弹窗里的提示行）
 *   #8B949E  次要文字（分节标题、系统事件、状态行、弹窗里的说明）
 *   #E0E0E0  主文字（正文、列表标题、悬停时的文字）
 *
 *   #4A9EFF  蓝：焦点与选中
 *   #2E7D32  绿：完成
 *   #FFB300  橙：等待
 *   #C62828  红：失败
 *
 * 纯白只留给输入光标那个方块：它落在空格上时只有底色看得见，
 * 比主文字再亮一档才能在一行文字里认出当前格。
 * 语义色底上的文字同理，不参与灰阶。
 */

/* 全局 */
Screen {
    background: #000000;
}

/* 弹窗类屏幕：弹窗本体在屏幕内水平垂直居中，遮罩半透明以透出下一层界面 */
ModalScreen {
    align: center middle;
    background: #000000 60%;
}

/* Home 屏幕：内容水平居中、垂直大致居中，底部状态栏贴在最下方 */
#home-frame {
    width: 100%;
    height: 100%;
    background: #000000;
}

/* 左栏是任务导航，中间是输入框与最近任务。左栏不抢焦点：点它才切会话，
   键盘仍然留在输入框里。左边界由 `Splitter` 那一列画。 */
#home-body {
    width: 100%;
    height: 1fr;
}

#home-side {
    width: 34;
    height: 100%;
    padding: 1 1;
    background: #0A0A0A;
}

#home-center {
    width: 1fr;
    height: 100%;
    align: center middle;
}

/* 最近任务：一行一条，最多四条；更多看左栏。高度封顶，矮终端里不把输入框顶上去。 */
#home-recent {
    width: 82;
    max-width: 100%;
    height: auto;
    max-height: 6;
    margin-top: 1;
}

/* 输入框下方的快捷入口：三个任务模板，点一下填进输入框，不提交。
   矮终端里整行收起（见 `HomeScreen.apply_quick_visibility`），这里只管常态。 */
#home-quick {
    width: 82;
    max-width: 100%;
    height: 1;
    margin-top: 1;
}

.quick-label {
    width: auto;
    height: 1;
    margin-right: 2;
    color: #4A4A4A;
}

.quick-task {
    width: auto;
    height: 1;
    margin-right: 2;
    color: #8B949E;
}

.quick-task:hover {
    color: #4A9EFF;
}

/* 左栏的分节标题：与上面那段留一行空白，第一段不留（列表顶部本来就贴着栏边）。
   列表行的高度写在组件自己的 DEFAULT_CSS 里（一行一条）。行用的类名是 `rail-row`：
   会话选择器那一屏的 `.session-row` 是两行条目，同名会把高度覆盖掉。 */
.rail-section {
    height: 1;
    margin-top: 1;
    color: #5A5A5A;
    text-style: bold;
}

.rail-section.-first {
    margin-top: 0;
}

.rail-row:hover {
    background: #1A1A1A;
}

.rail-row.-current {
    background: #1A1A1A;
}

.rail-empty {
    height: 1;
    padding: 0 1;
    color: #4A4A4A;
}

.topic-row:hover {
    background: #1A1A1A;
}

/* 字标：与输入框同宽、逐行居中。`home.py` 把每行补齐到同一宽度再拼，
   所以逐行居中等于整块居中；不补齐的话短的那几行会各自右移一格。 */
#home-logo {
    width: 82;
    max-width: 100%;
    color: #E0E0E0;
    text-align: center;
    height: auto;
}

/* 字标下方那行一句话定位：与字标同宽、居中，暗灰不与字标抢注意力 */
#home-tagline {
    width: 82;
    max-width: 100%;
    height: 1;
    margin-top: 1;
    margin-bottom: 1;
    text-align: center;
    color: #5A5A5A;
}

#home-box {
    width: 82;
    max-width: 100%;
    height: auto;
    background: #1A1A1A;
    margin-top: 0;
}

/* 文本框自身也加一条聚焦规则，让 Textual 在焦点变化时重算整块子树 */
#home-box:focus-within {
    background: #2A2A2A;
}

/* 左侧竖条：聚焦时点亮成蓝线，未聚焦时接近框底色 */
#home-accent-bar {
    width: 1;
    height: 100%;
    background: #2A2A2A;
}

#home-box:focus-within #home-accent-bar {
    background: #4A9EFF;
}

#home-box-main {
    width: 1fr;
    height: auto;
    padding: 1 2;
}

#home-prompt-row {
    width: 100%;
    height: auto;
    align-vertical: top;
}

#home-prompt-mark {
    width: auto;
    height: 1;
    color: #8B949E;
}

/* 输入框随内容换行增高，到高度上界后由自身滚动掩盖最早的内容 */
#home-input {
    width: 1fr;
    height: auto;
    max-height: 6;
    padding: 0 1;
    border: none;
    background: #1A1A1A;
    color: #E0E0E0;
    scrollbar-size-vertical: 0;
}

#home-input .text-area--placeholder {
    color: #5A5A5A;
}

/* 输入区跟着区块一起在聚焦时提亮。`#home-box:focus-within` 把区块底色抬到 #2A2A2A，
   而输入区自己写的是 #1A1A1A，不提亮的话焦点一进到输入框，输入区就比周围暗出一档 */
#home-box:focus-within #home-input {
    background: #2A2A2A;
}

#home-info {
    width: 100%;
    height: 1;
    margin-top: 1;
}

/* 输入框底部的操作提示：一行小字，点一下才动作。悬停抬一档，告诉用户这一格能点。 */
#home-actions {
    width: 100%;
    height: 1;
}

.home-action {
    width: auto;
    height: 1;
    margin-right: 2;
    color: #5A5A5A;
}

.home-action:hover {
    color: #E0E0E0;
}

/* 发送那一格靠右：它对应的动作是回车，摆在末位读起来像一句收尾。 */
#home-send-hint {
    width: 1fr;
    margin-right: 0;
    text-align: right;
    color: #4A4A4A;
}

#home-help {
    width: 82;
    max-width: 100%;
    height: 1;
    padding: 0 2;
    text-align: right;
    color: #4A4A4A;
}

#home-footer {
    width: 100%;
    height: 2;
    padding: 0 2 1 2;
    color: #4A4A4A;
    background: #000000;
}

#home-footer-left {
    width: 1fr;
    height: 1;
}

#home-footer-right {
    width: auto;
    height: 1;
}

/* Chat 屏幕 */
/* 会话名、目录、分支、用量与侧栏开关全部在底部这一行（见 `#status-bar`）。
   不单独设标题栏：那一行画的也是低优先级信息，而它要吃掉两行消息区。 */

#chat-body {
    height: 1fr;
}

/* 左栏：会话树在上、这一轮的主题在下。两段各自滚动，中间用一条横线分开。
   左边界由 `Splitter` 那一列画，这里不再写 border-right：两条线并排会看出双线。 */
#chat-rail {
    width: 30;
    height: 100%;
    padding: 0 1;
    background: #0A0A0A;
}

#chat-sessions {
    height: auto;
    max-height: 40%;
}

#chat-topics {
    height: 1fr;
    border-top: solid #1A1A1A;
}

/* 中间那一栏：对话与输入框。两者同宽同左边界，输入框不再横贯整屏。 */
#chat-main {
    width: 1fr;
    height: 100%;
}

#messages-pane {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    /* 轨道与屏幕底色同色所以不显形，条本身取三级文字那一档：在纯黑底上看得见，
       又不会比正文更抢眼。悬停与拖动各提一档，告诉用户手指点在了什么上面 */
    scrollbar-background: #000000;
    scrollbar-color: #5A5A5A;
    scrollbar-color-hover: #8B949E;
    scrollbar-color-active: #E0E0E0;
}

/* 上下文侧栏：默认隐藏，/sidebar 打开后占 30 列，中间那一栏让出这块宽度。
   与左栏同一条分界线画在 `#side-split` 上。 */
#side-panel {
    width: 30;
    height: 100%;
    background: #0A0A0A;
    padding: 0 1;
    display: none;
}

#side-panel.-visible {
    display: block;
}

#side-panel .side-title {
    height: 1;
    color: #E0E0E0;
    text-style: bold;
}

#side-panel .side-section {
    height: 1;
    margin-top: 1;
    /* 分节标题是结构标签，不是交互元素，用次要文字那一档加粗；
       亮蓝留给当前选中的条目。 */
    color: #8B949E;
    text-style: bold;
}

/* 第一段顶着上边缘：整栏只有二十来行，白空一行就是一条产物的位置。 */
#side-panel .side-section.-first {
    margin-top: 0;
}

#side-panel .side-line {
    height: auto;
    color: #8B949E;
}

#side-panel .side-body {
    height: auto;
    color: #8B949E;
}

/* 输入框区块：与状态栏同一层底色，底部四行连成一条，屏幕上方是消息、下方是操作区。
   区块自身不再铺一层比屏幕亮两档的灰：那块灰与纯黑之间是一条横贯整屏的硬边，
   聚焦时区块从 1 行长到 3 行，这条边还会跟着往上跳一下。
   与消息区的分界由 1 列宽的竖线（聚焦转蓝）与下方状态行承担 */
#editor-pane {
    height: auto;
    background: #0A0A0A;
    /* 上下不留内边距：竖线的首行要与输入文字那一行同一行。
       左内边距 3 列让输入的文字落在 x=5，与消息正文从同一列开始；
       竖线占它左边那一列（x=3），落在消息正文左侧的空档里 */
    padding: 0 3;
}

/* 模式切换用输入框下方的模式提示表达（见 `#editor-hint`），区块的上边界不跟着换色：
   一条常驻的彩色横线在整屏里比输入框本身还显眼。 */

#editor-body {
    width: 100%;
    height: auto;
    layout: horizontal;
    /* 不留内边距：竖线取 100% 高度，量的是这一块的内容区，上下都不留空白时，
       竖线占的行数与这一块的内容区完全重合，它的首行就是输入行、末行就是状态行，
       与区块上下边界之间也没有夹着空白 */
}

#editor-accent {
    width: 1;
    height: 100%;
    background: #2A2A2A;
}

/* 指示线由 EditorPane 在焦点进出时自己添加类。走 :focus-within 的话，
   规则命中的是 `#editor-pane` 自己，区块连同输入区与状态行一起重算样式再重绘，
   焦点每进出一次就闪一下。 */
#editor-accent.-focused {
    background: #4A9EFF;
}

#editor-main {
    width: 1fr;
    height: auto;
}

/* 输入区显式铺区块那层底色。不写的话会用到 TextArea 自带的 `background: $surface`，
   主题换成 gruvbox 之后 `$surface` 是 #3C3836，比区块的 #0A0A0A 亮出一大截，
   输入区看起来像单独铺了一块灰。

   左内边距 1 列把光标与竖线隔开：方块光标贴到竖线上时两段颜色连成一片，
   看不出光标在第一格还是第二格。

   一行底高、随内容长高、6 行封顶，再多出来的行由输入框自己滚动。底高取 1 行：
   输入框空着时也不该占三行，消息区每让出一行都是内容多看到一行。

   区块贴着底边、高度 auto，所以长高时是上边缘往上退、消息区被压短。
   失焦时状态行收起，整块只剩输入框；聚焦时是「输入 N 行 + 间距 1 + 状态 1」。 */
#editor-input {
    height: auto;
    min-height: 1;
    max-height: 6;
    padding: 0 1;
    border: none;
    background: #0A0A0A;
    color: #E0E0E0;
    scrollbar-size-vertical: 0;
}

/* 方块光标：白底、深色字。光标落在空格上时只有底色看得见，所以底色必须是白的那一层。
   启动界面的输入框一起改，两处光标保持同一副样子 */
#editor-input .text-area--cursor,
#home-input .text-area--cursor {
    color: #0A0A0A;
    background: #FFFFFF;
}

#editor-input .text-area--placeholder {
    color: #5A5A5A;
}

/* 状态行：Agent 与推理强度靠左，输入模式靠右；左侧内边距与输入区一致，
   让状态行与上面输入的文字从同一列开始。

   只在输入框聚焦时显示。失焦时用户是在读消息，这一行占的是消息区的高度。 */
#editor-status {
    width: 100%;
    height: 1;
    margin-top: 1;
    padding: 0 1;
    layout: horizontal;
}

#editor-status.-hidden {
    display: none;
}

#editor-agent {
    width: auto;
    height: 1;
    color: #8B949E;
}

#editor-effort {
    width: auto;
    height: 1;
    padding-left: 1;
    color: #8B949E;
}

#editor-hint {
    width: 1fr;
    height: 1;
    text-align: right;
    color: #5A5A5A;
}

/* 消息区顶端那条"上方还有多少条"的提示：占一行、灰字居中，滚到它附近就开始补更早的消息 */
#history-hint {
    height: 1;
    color: #5A5A5A;
    text-align: center;
}

/* 消息样式：两侧用同一档主文字。用户那一侧靠一块浅底区分，
   不再单独调亮文字——底色已经足够说明这是谁说的 */
.message-user {
    color: #E0E0E0;
    margin-bottom: 1;
}

/* 底色自带上下各一行内边距，正文那段的后边距不要再叠一层 */
.message-user .part-text {
    margin-bottom: 0;
}

.message-assistant {
    color: #E0E0E0;
    margin-bottom: 1;
}

.part-text {
    margin-bottom: 1;
}
/* 系统事件：重试、压缩、子任务、派发标记、引用文件、补丁摘要。
   一律取次要文字那一档，靠行首那个「·」认出来是系统说的话，不靠颜色。
   步骤分隔不画在界面上（见 `SimplePartView` 的 CSS），一条都不占行。 */
.part-file,
.part-agent,
.part-step_start,
.part-step_finish,
.part-patch,
.part-subtask,
.part-retry,
.part-compaction {
    color: #8B949E;
}

.part-error {
    color: #C62828;
}

/* 正文不使用强调色：收尾总结靠字重与上方留白，与普通回复分开 */
.part-summary {
    color: #E0E0E0;
    text-style: bold;
    margin-top: 1;
}

/* 思考过程属于某一步：左边那一条竖线落在步行的「▸」那一列，正文与步行的文字同一列。
   与正文取齐时它看起来像另起一段回复，看不出它属于哪一步。 */
.part-reasoning {
    margin-left: 2;
}

.part-reasoning.-hidden {
    display: none;
}

/* 状态栏：贴在最底部。左端会话名、目录、分支与生成中标记，右端占比数字与快捷键提示，
   最右是侧栏开关。整行取三级文字那一档，会话名不另外加粗——
   这一行的每一段都是背景信息，没有哪一段需要抢注意力。 */
#status-bar {
    height: 1;
    background: #0A0A0A;
    color: #5A5A5A;
    layout: horizontal;
    padding: 0 1;
}

#status-left {
    width: 1fr;
    height: 1;
    text-align: left;
    text-wrap: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #5A5A5A;
}

/* 占比数字左右各留一格，点开它的命中区域不至于只有两个字符宽。 */
#status-usage {
    width: auto;
    height: 1;
    padding: 0 1;
}

/* 上下文占比可以点开看每一项的用量：悬停时铺一层浅底，告诉用户这一块能点。
   数字的颜色由 Rich Text 自己给，CSS 的 color 盖不过它。 */
#status-usage:hover {
    background: #1A1A1A;
}

#status-keys {
    width: auto;
    height: 1;
    padding-left: 2;
    color: #4A4A4A;
}

/* 侧栏开关：未展开时与快捷键提示同一档暗色，展开时用主文字那一档。
   宽度取 auto，文字在「◧ 侧栏」与「◨ 收起」之间切换时不会跳位太厉害。
   这里不染色——展开只是显示状态，不是当前焦点。 */
#side-toggle {
    width: auto;
    height: 1;
    padding-left: 2;
    color: #4A4A4A;
}

#side-toggle:hover {
    color: #E0E0E0;
}

#side-toggle.-open {
    color: #8B949E;
}

/* 命令面板 */
#command-palette {
    align: center middle;
    width: 60%;
    max-width: 80;
    height: auto;
    max-height: 20;
    background: #1A1A1A 92%;
    border: tall #4A9EFF;
    padding: 0 1;
}

#palette-title {
    color: #4A9EFF;
    height: 1;
}

#palette-list {
    height: auto;
    max-height: 12;
}

#palette-hint {
    color: #5A5A5A;
    height: 1;
}

/* 会话选择器、模型、主题、帮助、Diff
   弹窗本体取分层底那一档、留一点透明透出下层的形状；边框与输入框的框线都取分隔线那一档。
   询问弹窗的版式与配色单独写在下面：它的层级关系与这些列表弹窗不同 */
#session-picker,
#theme-selector,
#tools-panel,
#help-screen,
#diff-overlay,
#confirm-dialog,
#rename-dialog,
#connection-form,
#message-dialog {
    align: center middle;
    width: 70%;
    max-width: 90;
    height: auto;
    max-height: 26;
    background: #1A1A1A 92%;
    border: tall #4A9EFF;
    padding: 0 1;
}

#picker-title,
#theme-title,
#tools-title,
#diff-title,
#connection-title,
#message-title {
    color: #4A9EFF;
    height: 1;
    text-style: bold;
}

#picker-hint,
#theme-hint,
#tools-hint,
#diff-hint,
#confirm-hint,
#rename-hint,
#connection-hint,
#message-hint {
    color: #5A5A5A;
    height: 1;
}

#message-body {
    height: auto;
    max-height: 18;
}

.message-line {
    color: #E0E0E0;
    height: auto;
}

/* 上下文占比的柱状图：贴底显示，底部留 1 行让开状态栏。
   宽度按内容固定：条 24 + 间隔 2 + 类别 10 + 数字 7，再留出边框与内边距。 */
ContextUsageScreen {
    align: center bottom;
}

#context-usage-dialog {
    width: 48;
    max-width: 90%;
    height: auto;
    max-height: 22;
    margin-bottom: 1;
    background: #1A1A1A 92%;
    border: tall #4A9EFF;
    padding: 0 1;
}

#context-usage-title {
    color: #4A9EFF;
    height: 1;
    text-style: bold;
}

#context-usage-window {
    color: #8B949E;
    height: 1;
    margin-bottom: 1;
}

.context-usage-line {
    height: 1;
}

#context-usage-hint {
    color: #5A5A5A;
    height: 1;
    margin-top: 1;
}

#session-list,
#theme-list,
#tools-list {
    height: auto;
    max-height: 16;
    /* 列表本身透明，透出弹窗那一层的底色；聚焦时 Textual 默认再叠一层 5% 的亮色，
       这里一并关掉——聚焦的反馈由光标那一行的底色承担 */
    background: transparent;
    background-tint: transparent;
}

/* 光标所在行抬一档底色加粗。默认档是主题的主色填充，整行铺一条亮蓝，
   与「当前会话」那一条蓝色标题撞在一起，两个含义分不开 */
#session-list ListItem.-highlight,
#theme-list ListItem.-highlight,
#tools-list ListItem.-highlight {
    background: #2A2A2A;
    color: #E0E0E0;
}

#session-list ListItem.-hovered,
#theme-list ListItem.-hovered,
#tools-list ListItem.-hovered {
    background: #2A2A2A;
}

/* 弹窗里的滚动条与消息区同一套三档。默认档取主题的 $scrollbar，是一道偏蓝的窄条，
   在这条灰阶里对不上；轨道跟着所在面板的底色走 */
#help-screen,
#diff-overlay,
#session-list,
#theme-list,
#tools-list,
#message-body {
    scrollbar-background: #1A1A1A;
    scrollbar-color: #5A5A5A;
    scrollbar-color-hover: #8B949E;
    scrollbar-color-active: #E0E0E0;
}

/* 会话列表：两行一条，标题与元信息分开配色 */
#session-list ListItem {
    height: auto;
    padding: 0 1;
}

/* 工具面板：同样两行一条，关掉的用灰字——一列扫下去先看见还开着哪些。
   它比别的弹窗宽：说明是一整句话，70% 宽在 100 列的终端里只剩 70 格，
   后半句一律被省略号吃掉，而「这个工具到底干什么」正是打开面板要看的东西。 */
#tools-panel {
    width: 86%;
    max-width: 120;
}

#tools-list ListItem {
    height: auto;
    padding: 0 1;
}

/* 主题列表：一条一行，当前主题亮蓝加粗，与会话列表同一套标记法 */
#theme-list ListItem {
    height: auto;
    padding: 0 1;
}

.theme-row {
    height: 1;
    color: #E0E0E0;
}

.theme-row.-current {
    color: #4A9EFF;
    text-style: bold;
}

.tool-row {
    height: auto;
}

.tool-row-title {
    height: 1;
    color: #E0E0E0;
    text-wrap: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 关掉的工具整行退一档：名字降到三级文字，说明降到四级。
   说明是打开这个面板要看的东西，开着的那一行取次要文字那一档，整句读得清 */
.tool-row-meta {
    height: 1;
    color: #8B949E;
    text-wrap: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tool-row.-off .tool-row-title {
    color: #5A5A5A;
}

.tool-row.-off .tool-row-meta {
    color: #4A4A4A;
}

.session-row {
    height: auto;
}

.session-row-title {
    height: 1;
    color: #E0E0E0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.session-row-title.-current {
    color: #4A9EFF;
    text-style: bold;
}

.session-row-meta {
    height: 1;
    color: #5A5A5A;
    overflow: hidden;
    text-overflow: ellipsis;
}

#confirm-text,
#rename-title {
    height: 2;
}

/* /model 表单：四行输入，标签浅灰、错误行用提示色 */
.connection-label {
    color: #8B949E;
    height: 1;
}

#connection-error {
    color: #C62828;
    height: 1;
}

/* 表单里的输入框比弹窗本体暗一档：弹窗是抬起来的一层，输入框是这一层上凹下去的一格。
   重命名与派发两个弹窗的输入框同一种处理 */
#connection-form Input,
#rename-dialog Input,
#spawn-dialog Input {
    background: #0A0A0A;
    border: tall #333333;
}

#connection-form Input:focus,
#rename-dialog Input:focus,
#spawn-dialog Input:focus {
    border: tall #4A9EFF;
}

/* 询问弹窗：照 macOS 授权面板的版式。
   边框与标题都不着色，层级靠亮度区分——标题最亮、说明中灰、按键提示最暗；
   橙色只留给原因行前面的警示图标。整块染成警告色的弹窗，每一张都像一条错误。
   宽度取终端的 76%，最宽 84 列；窄终端上正文自行折行，不设最小值，
   窗口再窄一点时弹窗不会超出屏幕。 */
#permission-dialog {
    width: 76%;
    max-width: 84;
    height: auto;
    max-height: 30;
    padding: 1 2;
    background: #1A1A1A 96%;
    border: round #333333;
}

#permission-eyebrow {
    color: #8B949E;
    height: 1;
}

#permission-title {
    color: #E0E0E0;
    height: 1;
    text-style: bold;
    margin-top: 1;
}

#permission-detail {
    color: #8B949E;
    height: 1;
}

#permission-label {
    color: #8B949E;
    height: 1;
    margin-top: 1;
}

/* 参数预览：单独一块更暗的底，不描边——描边会和弹窗自身的圆角边框叠成两层框。
   超过八行自己滚动，弹窗不会被撑破；滚动条压到一列宽，否则读长命令时
   默认两列的滚动条会挤掉正文右侧。 */
#permission-argument {
    background: #101010;
    padding: 0 1;
    height: auto;
    min-height: 3;
    max-height: 8;
    scrollbar-size-vertical: 1;
}

#permission-argument-text {
    color: #E0E0E0;
    height: auto;
}

/* 原因行：图标单独一格，正文用次要色。原因里会出现越界路径，
   路径带方括号时不能走 markup，因此两个部件都关闭了 markup。 */
#permission-reason-row {
    height: auto;
    margin-top: 1;
}

#permission-reason-icon {
    width: 2;
    color: #FFB300;
    height: auto;
}

#permission-reason {
    width: 1fr;
    color: #8B949E;
    height: auto;
}

/* 分隔线：一行反白横线裁到弹窗宽度，颜色取分隔线那一档 */
#permission-divider {
    color: #2A2A2A;
    height: 1;
    margin-top: 1;
}

/* 按钮行右对齐，主操作放在最右——与 macOS 对话框的按钮顺序一致 */
#permission-actions {
    height: 3;
    align-horizontal: right;
}

#permission-actions Static {
    width: auto;
    height: 3;
    padding: 0 2;
    margin-left: 2;
    content-align: center middle;
}

/* 拒绝是次要操作，只用灰色文字；全部允许的范围更大，用强调色但不填底，
   避免它与「允许一次」抢同一个视觉重心 */
#permission-deny {
    color: #8B949E;
}

#permission-all {
    color: #4A9EFF;
}

#permission-allow {
    background: #4A9EFF;
    color: #0A0A0A;
    text-style: bold;
}

#permission-hint {
    color: #5A5A5A;
    height: auto;
}

/* 帮助界面 */
.help-section {
    color: #4A9EFF;
    text-style: bold;
    margin-top: 1;
    height: 1;
}

#help-keys,
#help-commands {
    color: #E0E0E0;
    height: auto;
}

#help-hint {
    color: #5A5A5A;
    height: 1;
}

/* Diff 覆盖层 */
#diff-body {
    height: auto;
    padding: 0 1;
}

/* Toast 通知的尺寸与四档底色写在 `vsagent/widgets/toast.py` 的 DEFAULT_CSS 里：
   容器与提示条是一对，拆到两个文件里改一处漏一处。 */

/* ------------------------------------------------------------------ */
/* 子 agent                                                            */
/* ------------------------------------------------------------------ */

/* 右栏的产物列表。一行一条，宽度沿用 #side-panel：handle 只有十来个字符，
   真正的路径在运行目录里，列在这里反而不像能把名字抄走的东西。 */
#side-artifacts {
    height: auto;
    max-height: 7;
    background: #0A0A0A;
    border: none;
    padding: 0;
}

#side-artifacts > .option-list--option {
    height: 1;
    padding: 0;
    color: #4A9EFF;
}

#side-artifacts > .option-list--option-highlighted {
    background: #1A1A1A;
    color: #E0E0E0;
}

#side-artifacts > .option-list--option-disabled {
    color: #5A5A5A;
}

/* 右栏的子 agent 列表。宽度沿用 #side-panel 的 30 列：
   再宽会吃掉消息区，而标题已经按 12 格截过。 */
#side-agents {
    height: auto;
    max-height: 10;
    background: #0A0A0A;
    border: none;
    padding: 0;
}

#side-agents > .option-list--option {
    height: 2;
    padding: 0;
    color: #8B949E;
}

#side-agents > .option-list--option-highlighted {
    background: #1A1A1A;
    color: #E0E0E0;
}

#side-agents-title {
    height: 1;
}

/* 子 agent 界面顶部的返回栏：整条可点。底色取分层底，文字取次要文字那一档；
   悬停时文字转主文字那一档——这里没有「选中」的含义，不用蓝色。 */
#subagent-banner {
    height: 1;
    background: #1A1A1A;
    color: #8B949E;
    padding: 0 1;
}

#subagent-banner:hover {
    background: #1A1A1A;
    color: #E0E0E0;
}

/* 「仅创建」留下的任务：整条可点，橙色表示它在等人决定要不要开始 */
#subagent-start {
    height: 1;
    display: none;
    background: #1A1A1A;
    color: #FFB300;
    padding: 0 1;
}

#subagent-start:hover {
    background: #1A1A1A;
    color: #E0E0E0;
}

/* 派发模态 */
SpawnAgentScreen {
    align: center middle;
}

#spawn-dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    background: #1A1A1A 92%;
    border: solid #333333;
    padding: 1 2;
}

#spawn-title {
    height: 1;
    color: #E0E0E0;
    text-style: bold;
}

/* 字段名与 /model 表单的标签同一档：它们是结构标签，
   亮蓝只留给焦点与选中 */
.spawn-label {
    height: 1;
    margin-top: 1;
    color: #8B949E;
}

#spawn-range {
    height: 3;
}

#spawn-range Input {
    width: 8;
}

#spawn-arrow {
    width: 3;
    content-align: center middle;
    color: #8B949E;
}

#spawn-total {
    width: 1fr;
    content-align: right middle;
    color: #8B949E;
}

#spawn-preview {
    height: auto;
    color: #8B949E;
}

#spawn-task {
    height: 7;
    background: #0A0A0A;
    border: solid #333333;
    scrollbar-background: #0A0A0A;
    scrollbar-color: #5A5A5A;
    scrollbar-color-hover: #8B949E;
    scrollbar-color-active: #E0E0E0;
}

#spawn-error {
    height: 1;
    color: #C62828;
}

#spawn-hint {
    height: 2;
    color: #5A5A5A;
}

#spawn-buttons {
    height: 3;
    align-horizontal: right;
}

/* 派发弹窗的按钮：默认档取分层底与分隔线；主按钮取焦点蓝配深色字，
   与询问弹窗那三个按键色块同一种做法。悬停时默认档抬一档底色，
   主按钮把框线换成主文字那一档，不另造一个蓝 */
#spawn-buttons Button {
    margin-left: 2;
    background: #1A1A1A;
    color: #E0E0E0;
    border: tall #333333;
}

#spawn-buttons Button:hover {
    background: #2A2A2A;
    border: tall #4A4A4A;
}

#spawn-buttons Button.-primary {
    background: #4A9EFF;
    color: #0A0A0A;
    border: tall #4A9EFF;
}

#spawn-buttons Button.-primary:hover {
    background: #4A9EFF;
    border: tall #E0E0E0;
}
